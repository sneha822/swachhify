# Copy to .env for local overrides. Every value has a working development default.

ENV=development
DEBUG=true
# Any long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-in-production-please-32+chars

# SQLite by default; PostgreSQL in docker-compose / production:
# DATABASE_URL=postgresql+psycopg://swacchify:swacchify@localhost:5432/swacchify
DATABASE_URL=sqlite:///./swacchify.db
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true
# First admin for a fresh production database (demo data has its own admin)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional. Enables Redis pub/sub for WebSockets across instances and real Celery workers.
# REDIS_URL=redis://localhost:6379/0

# Comma-separated list of the site origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Swacchify AI. Without a key the assistant answers from the curated knowledge base only.
# Get a key at https://console.anthropic.com, paste it below and remove the leading "#".
# ANTHROPIC_API_KEY=sk-ant-...
AI_ENABLED=true
AI_MODEL=claude-opus-5
AI_EFFORT=low
AI_RATE_LIMIT_PER_MINUTE=12

# Uploads (collection proof photos)
STORAGE_BACKEND=local
MEDIA_DIR=./media
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_PUBLIC_BASE_URL=

# Outbound messaging providers (console = log only)
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

DEFAULT_CITY=Jaipur
DEFAULT_LAT=26.9124
DEFAULT_LNG=75.7873
